  "cards": [
    {
      "dot": "cyan",
      "title": "参考事务；项目启动状态见恢复子图",
      "items": [
        "ECB 请求 / 响应与序列校验保留；控制权必须单一且可追踪",
        "接收内存与队列就绪后才开流；超时重试须识别非幂等寄存器"
      ]
    },
    {
      "dot": "orange",
      "title": "时钟、复位与重新枚举",
      "items": [
        "四域频率、CDC、复位释放、PTP 失锁策略由 RTL 与板级设计绑定",
        "停流 → 排空 / 隔离 DMA → 重建映射 → 校验 → 再开流；不可盲目复位"
      ]
    }
  ]
