{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "启动与故障恢复 · 拟议状态协议",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      630
    ],
    "visual_preset": "signal-flow"
  },
  "lanes": [
    {
      "id": "main",
      "label": "启动条件由左至右满足"
    },
    {
      "id": "run-fault",
      "label": "故障恢复；禁止旧代际数据重新入流"
    },
    {
      "id": "terminal",
      "label": "停用与资源释放"
    }
  ],
  "states": [
    {
      "id": "run-stop",
      "type": "start",
      "label": "禁止采集",
      "sublabel": "执行输出受控",
      "lane": "main",
      "col": 0
    },
    {
      "id": "run-config",
      "type": "active",
      "label": "配置与时钟",
      "sublabel": "寄存器 / PTP",
      "lane": "main",
      "col": 1
    },
    {
      "id": "run-memory",
      "type": "active",
      "label": "接收资源",
      "sublabel": "MR / QP / CQ",
      "lane": "main",
      "col": 2
    },
    {
      "id": "run-check",
      "type": "decision",
      "label": "就绪校验",
      "sublabel": "格式 / 版本 / 时标",
      "lane": "main",
      "col": 3
    },
    {
      "id": "run-stream",
      "type": "active",
      "label": "允许采集",
      "sublabel": "运行与监测",
      "lane": "main",
      "col": 4
    },
    {
      "id": "run-quiesce",
      "type": "failure",
      "label": "停流与隔离",
