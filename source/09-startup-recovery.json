      "variant": "security",
      "labelAt": [
        817,
        235
      ]
    },
    {
      "id": "run-rebuild",
      "from": "run-quiesce",
      "to": "run-config",
      "label": "排空后重建新代际",
      "variant": "dashed",
      "fromSide": "left",
      "toSide": "bottom",
      "via": [
        [
          619,
          307
        ],
        [
          619,
          400
        ],
        [
          248,
          400
        ]
      ],
      "labelAt": [
        433,
        386
      ]
    },
    {
      "id": "run-exit",
      "from": "run-quiesce",
      "to": "run-disabled",
      "label": "恢复失败或停止",
      "variant": "security",
      "labelAt": [
        825,
        375
      ]
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "状态进入条件必须可检查",
      "items": [
        "资源未就绪禁止开流；校验失败停留在门槛，不能自动放行",
        "PTP 未锁定时是否允许降级须按场景定义，不默认等同硬同步"
      ]
    },
    {
      "dot": "orange",
      "title": "恢复行为尚待实现与故障注入",
      "items": [
        "失锁、丢包、复位、GPU 卡顿分别绑定动作与超时；不可盲目重试",
        "旧映射失效前证明 DMA 已停止；控制器独立处理陈旧命令"
      ]
    }
  ]
}
