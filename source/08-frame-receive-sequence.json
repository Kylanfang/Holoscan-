  "cards": [
    {
      "dot": "cyan",
      "title": "启动前置条件与正常路径",
      "items": [
        "MR / QP / CQ 和接收缓冲先就绪；图示顺序须映射到实际驱动 API",
        "完整性校验可依实现用 CPU 或 GPU；失败进入隔离而非提交推理"
      ]
    },
    {
      "dot": "orange",
      "title": "不支持复用许可时不能照搬末步",
      "items": [
        "须证明固定接收区时限，或 GPU 内复制到独立工作区",
        "DMA 与 GPU 并发读写需要平台规定的可见性机制，CQE 不替代它"
      ]
    }
