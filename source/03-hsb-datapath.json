  "cards": [
    {
      "dot": "cyan",
      "title": "接口契约：不能把 AXI-S 当作任意字节流",
      "items": [
        "HSB 2.7 文档：TKEEP 忽略；完整 TDATA 发送，填充需计入长度约定",
        "TLAST、窗口、CRC 覆盖与变长帧须成组验证，禁止半帧静默消费"
      ]
    },
    {
      "dot": "orange",
      "title": "过载策略待实现；参考延迟不是端到端指标",
      "items": [
        "各模态 FIFO / 仲裁 / 可暂停性 / 整帧丢弃 / 恢复均见契约台账",
        "9 Gbit/s 停顿 20 ms 需 22.5 MB；50 周期仅为参考包化条件"
      ]
    }
