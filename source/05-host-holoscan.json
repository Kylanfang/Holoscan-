  "cards": [
    {
      "dot": "cyan",
      "title": "两条物理路径分别验收",
      "items": [
        "RoCE：NIC 直写注册缓冲；Socket：CPU / 内核接收后按平台交接 GPU",
        "FPGA PCIe DMA 是另一候选后端，未纳入本图基准主路径"
      ]
    },
    {
      "dot": "orange",
      "title": "缓冲复用与工作区隔离",
      "items": [
        "释放不能凭图约束发送端；须证明信用 / 地址轮换或时限机制",
        "必要时 GPU 内复制到工作区；不等于 CPU 参与有效载荷拷贝"
      ]
    }
